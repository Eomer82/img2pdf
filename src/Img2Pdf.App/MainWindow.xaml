<ui:FluentWindow x:Class="Img2Pdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Img2Pdf.App.ViewModels"
        xmlns:models="clr-namespace:Img2Pdf.App.Models"
        xmlns:services="clr-namespace:Img2Pdf.App.Services"
        xmlns:loc="clr-namespace:Img2Pdf.App.Services"
        mc:Ignorable="d"
        Title="{loc:Translate AppTitle}"
        Height="840" Width="1180"
        MinHeight="660" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        KeyDown="OnWindowKeyDown">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Status badges style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tittellinje i Windows 11 Fluent stil med språk- og temavalg -->
        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Translate AppHeaderTitle}"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <ui:Button Content="{loc:Translate ThemeToggle}" 
                               Icon="{ui:SymbolIcon WeatherMoon24}" 
                               Click="OnToggleThemeClicked" 
                               Appearance="Transparent" 
                               Padding="6,4" 
                               FontSize="12" 
                               Margin="0,0,4,0" />

                    <ui:Button x:Name="LanguageButton"
                               Content="{Binding CurrentLanguage.DisplayName, Source={x:Static services:LocalizationService.Instance}}" 
                               Icon="{ui:SymbolIcon LocalLanguage24}" 
                               Click="OnLanguageMenuClicked" 
                               Appearance="Transparent" 
                               Padding="6,4" 
                               FontSize="12" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Hovedinnhold -->
        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- VENSTRE: Filliste & Handlinger -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Handlingsknapper over listen -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <ui:Button Content="{loc:Translate AddFiles}"
                               Icon="{ui:SymbolIcon ImageAdd24}"
                               Appearance="Primary"
                               Click="OnAddFilesClicked"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate AddFolder}"
                               Icon="{ui:SymbolIcon FolderAdd24}"
                               Click="OnAddFolderClicked"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate PasteImage}"
                               Icon="{ui:SymbolIcon ClipboardPaste24}"
                               Command="{Binding PasteFromClipboardCommand}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate ExtractPdf}"
                               Icon="{ui:SymbolIcon DocumentArrowRight24}"
                               Command="{Binding ExtractPdfPagesCommand}"
                               IsEnabled="{Binding IsSelectedPdf}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate QuickLook}"
                               Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding OpenPreviewCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate Rotate}"
                               Icon="{ui:SymbolIcon ArrowRotateClockwise24}"
                               Command="{Binding RotateSelectedCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate MoveUp}"
                               Icon="{ui:SymbolIcon ChevronUp24}"
                               Command="{Binding MoveUpCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate MoveDown}"
                               Icon="{ui:SymbolIcon ChevronDown24}"
                               Command="{Binding MoveDownCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate Remove}"
                               Icon="{ui:SymbolIcon Delete48}"
                               Appearance="Secondary"
                               Command="{Binding RemoveSelectedCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate ClearList}"
                               Appearance="Transparent"
                               Command="{Binding ClearAllCommand}"
                               IsEnabled="{Binding HasFiles}"
                               Margin="0,0,0,6" />
                </WrapPanel>

                <!-- Tom visning: Dra og slipp-plakat -->
                <ui:Card Grid.Row="1" 
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload48" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Translate DropAreaTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Translate DropAreaSubtitle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="{loc:Translate ChooseFiles}" Click="OnAddFilesClicked" Margin="0,0,10,0" />
                            <ui:Button Content="{loc:Translate ChooseFolder}" Click="OnAddFolderClicked" Margin="0,0,10,0" />
                            <ui:Button Content="{loc:Translate PasteImage}" Command="{Binding PasteFromClipboardCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Filliste (ListView) når elementer er lagt til -->
                <ui:Card Grid.Row="1" 
                         Padding="4" 
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ListView x:Name="FilesListView"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnListViewPreviewMouseLeftButtonDown"
                              MouseMove="OnListViewMouseMove"
                              DragOver="OnListViewDragOver"
                              Drop="OnListViewDrop"
                              GridViewColumnHeader.Click="OnColumnHeaderClick">

                        <!-- Moderne markering for valgt rad med god kontrast -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="42" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemDoubleClick" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    CornerRadius="4"
                                                    Margin="2,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#264CC2FF" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#804CC2FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <!-- Filnavn & Miniatyrbilde med rotasjonsvisning og PDF-ikon -->
                                <GridViewColumn Header="{loc:Translate Col_FileName}" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                                <Grid Width="34" Height="34" Margin="0,0,8,0">
                                                    <ui:SymbolIcon x:Name="FallbackIcon" Symbol="Image32" Foreground="#4CC2FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <ui:SymbolIcon x:Name="PdfIcon" Symbol="DocumentBulletList24" Foreground="#FF6B6B" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <Border x:Name="ThumbBorder" CornerRadius="4" ClipToBounds="True" Visibility="Collapsed" Background="#11FFFFFF">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                                            <Image.LayoutTransform>
                                                                <RotateTransform Angle="{Binding TotalRotation}" />
                                                            </Image.LayoutTransform>
                                                        </Image>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding FileName}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                                    <Setter TargetName="PdfIcon" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ThumbBorder" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasThumbnail}" Value="True" />
                                                        <Condition Binding="{Binding IsPdf}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ThumbBorder" Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Oppløsning / Sidetall -->
                                <GridViewColumn Header="{loc:Translate Col_Dimensions}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Dimensions}" 
                                                       VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Størrelse -->
                                <GridViewColumn Header="{loc:Translate Col_Size}" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedSize}" 
                                                       VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Status: Høy kontrast merker med lokalisert tekst -->
                                <GridViewColumn Header="{loc:Translate Col_Status}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Style.Triggers>
                                                             <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Venter}">
                                                                <Setter Property="Background" Value="#25888888" />
                                                                <Setter Property="TextBlock.Foreground" Value="#E0E0E0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Behandler}">
                                                                <Setter Property="Background" Value="#334CC2FF" />
                                                                <Setter Property="TextBlock.Foreground" Value="#4CC2FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Fullført}">
                                                                <Setter Property="Background" Value="#3354D281" />
                                                                <Setter Property="TextBlock.Foreground" Value="#54D281" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Feilet}">
                                                                <Setter Property="Background" Value="#33FF6B6B" />
                                                                <Setter Property="TextBlock.Foreground" Value="#FF6B6B" />
                                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Mappe -->
                                <GridViewColumn Header="{loc:Translate Col_Folder}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Directory}" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ui:Card>

                <!-- Bunnlinje: Status, Estimat og Fremgang -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusSummary}" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" 
                                       Margin="0,0,14,0" />
                            <TextBlock Text="{Binding EstimatedOutputSize}" 
                                       FontSize="12"
                                       Foreground="#4CC2FF"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ProgressText}" 
                                   HorizontalAlignment="Right" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Value="{Binding ProgressValue}"
                                 Maximum="100"
                                 Height="8"
                                 BorderThickness="0" />
                </Grid>
            </Grid>

            <!-- HØYRE: Innstillinger og Konverteringsknapp -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                    <!-- Kort: Hurtigprofiler (Presets) -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Presets}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <WrapPanel>
                                <ui:Button Content="{loc:Translate Preset_Standard}" Command="{Binding ApplyPresetCommand}" CommandParameter="standard" Margin="0,0,6,6" Padding="8,4" FontSize="11" />
                                <ui:Button Content="{loc:Translate Preset_Receipts}" Command="{Binding ApplyPresetCommand}" CommandParameter="receipts" Margin="0,0,6,6" Padding="8,4" FontSize="11" />
                                <ui:Button Content="{loc:Translate Preset_PhotoAlbum}" Command="{Binding ApplyPresetCommand}" CommandParameter="photoalbum" Margin="0,0,6,6" Padding="8,4" FontSize="11" />
                                <ui:Button Content="{loc:Translate Preset_DocScan}" Command="{Binding ApplyPresetCommand}" CommandParameter="documentscan" Margin="0,0,6,6" Padding="8,4" FontSize="11" />
                                <ui:Button Content="{loc:Translate Preset_Email}" Command="{Binding ApplyPresetCommand}" CommandParameter="email" Margin="0,0,6,6" Padding="8,4" FontSize="11" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Konverteringsmodus -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_ModeTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Mode_Individual}"
                                         IsChecked="{Binding IsIndividualMode, Mode=TwoWay}"
                                         Margin="0,0,0,6" />
                            <RadioButton Content="{loc:Translate Mode_Merged}"
                                         IsChecked="{Binding IsMergedMode, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <!-- Filnavn for samlet PDF -->
                            <StackPanel Margin="24,6,0,0" 
                                        Visibility="{Binding IsMergedMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate MergedFileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MergedFileName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Bilde- & Dokumentfilter -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Filter}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Filter_Original}"
                                         IsChecked="{Binding IsOriginalFilter, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <RadioButton Content="{loc:Translate Filter_Grayscale}"
                                         IsChecked="{Binding IsGrayscaleFilter, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <RadioButton Content="{loc:Translate Filter_BlackAndWhite}"
                                         IsChecked="{Binding IsBlackAndWhiteFilter, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Kvalitet & Komprimering -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Quality}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Quality_Lossless}"
                                         IsChecked="{Binding IsLosslessQuality, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Quality_LosslessDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Quality_Compressed}"
                                         IsChecked="{Binding IsCompressedQuality, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Quality_CompressedDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <!-- Slider for komprimeringsgrad -->
                            <StackPanel Margin="24,0,0,4" Visibility="{Binding IsCompressedQuality, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding JpegQuality, StringFormat='{}{0}%'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                    <TextBlock Text="{loc:Translate CompressionLevel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="50" Maximum="95" Value="{Binding JpegQuality, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Sideoppsett & Marger -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_PageSetup}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Size_Original}"
                                         IsChecked="{Binding IsOriginalSize, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Size_OriginalDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Size_A4}"
                                         IsChecked="{Binding IsA4Size, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Size_A4Desc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Size_Letter}"
                                         IsChecked="{Binding IsLetterSize, Mode=TwoWay}"
                                         Margin="0,0,0,4" />

                            <!-- Bilder per side (1, 2, 4) -->
                            <TextBlock Text="{loc:Translate ImagesPerPage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,8,0,4" />
                            <RadioButton Content="{loc:Translate OnePerPage}"
                                         IsChecked="{Binding IsOneImagePerPage, Mode=TwoWay}"
                                         Margin="0,0,0,4" FontSize="12" />
                            <RadioButton Content="{loc:Translate TwoPerPage}"
                                         IsChecked="{Binding IsTwoImagesPerPage, Mode=TwoWay}"
                                         Margin="0,0,0,4" FontSize="12" />
                            <RadioButton Content="{loc:Translate FourPerPage}"
                                         IsChecked="{Binding IsFourImagesPerPage, Mode=TwoWay}"
                                         Margin="0,0,0,4" FontSize="12" />

                            <!-- Sidemarger (kun tilgjengelig for A4 og Letter) -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasMarginsConfigurable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate Section_Margins}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                <RadioButton Content="{loc:Translate Margin_None}"
                                             IsChecked="{Binding IsMarginNone, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                                <RadioButton Content="{loc:Translate Margin_Compact}"
                                             IsChecked="{Binding IsMarginCompact, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                                <RadioButton Content="{loc:Translate Margin_Normal}"
                                             IsChecked="{Binding IsMarginNormal, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Sidetall & Vannmerke -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Decorations}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <!-- Sidetall -->
                            <CheckBox Content="{loc:Translate EnablePageNumbers}"
                                      IsChecked="{Binding EnablePageNumbers, Mode=TwoWay}"
                                      Margin="0,0,0,4" />
                            <StackPanel Margin="24,2,0,8" Visibility="{Binding EnablePageNumbers, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate PageNumberFormatLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,2" />
                                <TextBox Text="{Binding PageNumberFormat, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Vannmerke -->
                            <CheckBox Content="{loc:Translate EnableWatermark}"
                                      IsChecked="{Binding EnableWatermark, Mode=TwoWay}"
                                      Margin="0,4,0,4" />
                            <StackPanel Margin="24,2,0,2" Visibility="{Binding EnableWatermark, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate WatermarkTextLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,2" />
                                <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Bildetekst -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Captions}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <CheckBox Content="{loc:Translate ShowCaptions}"
                                      IsChecked="{Binding ShowCaptions, Mode=TwoWay}"
                                      Margin="0,0,0,4" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: System & Søkbar PDF -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_AdvancedFeatures}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <!-- Søkbar PDF (OCR) -->
                            <CheckBox Content="{loc:Translate EnableOcr}"
                                      IsChecked="{Binding EnableOcr, Mode=TwoWay}"
                                      IsEnabled="{Binding IsOcrSupported}"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate OcrDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <!-- Høyreklikkmeny -->
                            <CheckBox Content="{loc:Translate EnableContextMenu}"
                                      IsChecked="{Binding EnableContextMenuIntegration, Mode=TwoWay}"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate ContextMenuDescription}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: PDF Metadata -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Metadata}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <TextBlock Text="{loc:Translate DocTitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Text="{loc:Translate DocAuthor}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DocumentAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                            <TextBlock Text="{loc:Translate DocSubject}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DocumentSubject, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Utdatamappe -->
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_OutputFolder}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Output_Source}"
                                         IsChecked="{Binding UseSourceFolder, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <RadioButton Content="{loc:Translate Output_Custom}"
                                         IsChecked="{Binding UseCustomOutputFolder, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <DockPanel Margin="0,4,0,10"
                                       Visibility="{Binding UseCustomOutputFolder, Converter={StaticResource BoolToVis}}">
                                <ui:Button DockPanel.Dock="Right" Content="{loc:Translate Browse}" Click="OnBrowseFolderClicked" Margin="6,0,0,0" />
                                <TextBox Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <CheckBox Content="{loc:Translate OpenWhenDone}"
                                      IsChecked="{Binding OpenFolderWhenDone, Mode=TwoWay}"
                                      Margin="0,4,0,4" />

                            <CheckBox Content="{loc:Translate OpenPdfWhenDone}"
                                      IsChecked="{Binding OpenPdfWhenDone, Mode=TwoWay}"
                                      Margin="0,0,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Sikkerhet & Passordbeskyttelse -->
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Security}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <CheckBox Content="{loc:Translate Security_Enable}"
                                      IsChecked="{Binding EnablePasswordProtection, Mode=TwoWay}"
                                      Margin="0,0,0,6" />

                            <StackPanel Margin="24,2,0,0"
                                        Visibility="{Binding EnablePasswordProtection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate Security_PasswordLabel}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="12" 
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{loc:Translate Security_Desc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Handlinger etter konvertering har Margin="0,0,0,0" siden det er siste kort i rullisten -->
                </StackPanel>
            </ScrollViewer>

            <!-- Fastlåst bunnpanel: Start / Avbryt konvertering (Alltid synlig uavhengig av scrolling) -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <!-- Start-knapp -->
                <ui:Button Content="{loc:Translate StartConversion}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon PlayCircle24}"
                           Height="48"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Stretch"
                           Command="{Binding StartConversionCommand}"
                           IsEnabled="{Binding CanConvert}"
                           Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVis}}" />

                <!-- Avbryt-knapp (vises kun under kjøring) -->
                <ui:Button Content="{loc:Translate CancelConversion}"
                           Appearance="Danger"
                           Icon="{ui:SymbolIcon DismissCircle24}"
                           Height="48"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Stretch"
                           Command="{Binding CancelConversionCommand}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>

        <!-- Hurtigvisning (Quick Look Preview Overlay Modal) -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVis}}"
              Background="#E6080A0E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tittel og handlingslinje for forhåndsvisning -->
            <Border Grid.Row="0" Background="#33FFFFFF" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Eye24" Foreground="#4CC2FF" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PreviewItem.FileName}" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewItem.Dimensions}" FontSize="12" Foreground="#D0D0D0" />
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewItem.FormattedSize}" FontSize="12" Foreground="#D0D0D0" />
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewItem.TotalRotation, StringFormat='{}{0}°'}" FontSize="12" Foreground="#4CC2FF" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="{loc:Translate Crop}"
                                   Icon="{ui:SymbolIcon Crop24}"
                                   Command="{Binding ToggleCropModeCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Translate Rotate}"
                                   Icon="{ui:SymbolIcon ArrowRotateClockwise24}"
                                   Command="{Binding RotateSelectedCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Translate Close}"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Appearance="Secondary"
                                   Command="{Binding ClosePreviewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bildeviser med navigasjonspiler og Crop-verktøylinje -->
            <Grid Grid.Row="1" Margin="24">
                <!-- Beskjærings-kontrollpanel -->
                <Border VerticalAlignment="Top" 
                        Background="#D0151820" 
                        CornerRadius="8" 
                        Margin="30,10,30,0" 
                        Padding="14,10" 
                        Panel.ZIndex="10" 
                        Visibility="{Binding IsCropModeActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Translate CropMode}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#4CC2FF" Margin="0,0,16,0" />

                        <TextBlock Text="{loc:Translate CropTrimLeft}" VerticalAlignment="Center" Foreground="#DDD" Margin="0,0,4,0" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding PreviewItem.CropLeft, Mode=TwoWay}" Width="70" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <TextBlock Text="{loc:Translate CropTrimTop}" VerticalAlignment="Center" Foreground="#DDD" Margin="0,0,4,0" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding PreviewItem.CropTop, Mode=TwoWay}" Width="70" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <TextBlock Text="{loc:Translate CropTrimRight}" VerticalAlignment="Center" Foreground="#DDD" Margin="0,0,4,0" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding PreviewItem.CropRight, Mode=TwoWay}" Width="70" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <TextBlock Text="{loc:Translate CropTrimBottom}" VerticalAlignment="Center" Foreground="#DDD" Margin="0,0,4,0" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding PreviewItem.CropBottom, Mode=TwoWay}" Width="70" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <ui:Button Content="{loc:Translate ResetCrop}" Command="{Binding ResetCropCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Forrige-knapp -->
                <ui:Button Command="{Binding PreviousPreviewCommand}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Padding="12,18"
                           Margin="8,0,0,0"
                           ToolTip="Previous (Left Arrow)">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="24" />
                </ui:Button>

                <!-- Bildevisning (hvis ikke PDF) -->
                <Border CornerRadius="8" ClipToBounds="True" Background="#11FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60,0">
                    <Grid>
                        <!-- PDF-visning -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60" Visibility="{Binding PreviewItem.IsPdf, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="#FF6B6B" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="{loc:Translate PdfDocument}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PreviewItem.Dimensions}" FontSize="14" HorizontalAlignment="Center" Foreground="#AAAAAA" />
                        </StackPanel>

                        <!-- Normal bildevisning -->
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               MaxHeight="620"
                               MaxWidth="900"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.LayoutTransform>
                                <RotateTransform Angle="{Binding PreviewItem.TotalRotation}" />
                            </Image.LayoutTransform>
                        </Image>
                    </Grid>
                </Border>

                <!-- Neste-knapp -->
                <ui:Button Command="{Binding NextPreviewCommand}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Padding="12,18"
                           Margin="0,0,8,0"
                           ToolTip="Next (Right Arrow)">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="24" />
                </ui:Button>
            </Grid>

            <!-- Hjelpetekst i bunnen -->
            <Border Grid.Row="2" Background="#11FFFFFF" Padding="12,8">
                <TextBlock Text="Tip: Space or Esc to close • Left/Right arrows to flip • R to rotate • C to crop"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#88FFFFFF" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
