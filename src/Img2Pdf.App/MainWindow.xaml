<ui:FluentWindow x:Class="Img2Pdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Img2Pdf.App.ViewModels"
        xmlns:models="clr-namespace:Img2Pdf.App.Models"
        xmlns:services="clr-namespace:Img2Pdf.App.Services"
        xmlns:loc="clr-namespace:Img2Pdf.App.Services"
        mc:Ignorable="d"
        Title="{loc:Translate AppTitle}"
        Height="780" Width="1120"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Status badges style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tittellinje i Windows 11 Fluent stil med språk- og temavalg -->
        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Translate AppHeaderTitle}"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <ui:Button Content="{loc:Translate ThemeToggle}" 
                               Icon="{ui:SymbolIcon WeatherMoon24}" 
                               Click="OnToggleThemeClicked" 
                               Appearance="Transparent" 
                               Padding="6,4" 
                               FontSize="12" 
                               Margin="0,0,4,0" />

                    <ui:Button x:Name="LanguageButton"
                               Content="{Binding CurrentLanguage.DisplayName, Source={x:Static services:LocalizationService.Instance}}" 
                               Icon="{ui:SymbolIcon LocalLanguage24}" 
                               Click="OnLanguageMenuClicked" 
                               Appearance="Transparent" 
                               Padding="6,4" 
                               FontSize="12" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Hovedinnhold -->
        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- VENSTRE: Filliste & Handlinger -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Handlingsknapper over listen -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <ui:Button Content="{loc:Translate AddFiles}"
                               Icon="{ui:SymbolIcon ImageAdd24}"
                               Appearance="Primary"
                               Click="OnAddFilesClicked"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate AddFolder}"
                               Icon="{ui:SymbolIcon FolderAdd24}"
                               Click="OnAddFolderClicked"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate Rotate}"
                               Icon="{ui:SymbolIcon ArrowRotateClockwise24}"
                               Command="{Binding RotateSelectedCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate MoveUp}"
                               Icon="{ui:SymbolIcon ChevronUp24}"
                               Command="{Binding MoveUpCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate MoveDown}"
                               Icon="{ui:SymbolIcon ChevronDown24}"
                               Command="{Binding MoveDownCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate Remove}"
                               Icon="{ui:SymbolIcon Delete48}"
                               Appearance="Secondary"
                               Command="{Binding RemoveSelectedCommand}"
                               IsEnabled="{Binding HasSelectedItem}"
                               Margin="0,0,8,6" />
                    <ui:Button Content="{loc:Translate ClearList}"
                               Appearance="Transparent"
                               Command="{Binding ClearAllCommand}"
                               IsEnabled="{Binding HasFiles}"
                               Margin="0,0,0,6" />
                </WrapPanel>

                <!-- Tom visning: Dra og slipp-plakat -->
                <ui:Card Grid.Row="1" 
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload48" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Translate DropAreaTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Translate DropAreaSubtitle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="{loc:Translate ChooseFiles}" Click="OnAddFilesClicked" Margin="0,0,10,0" />
                            <ui:Button Content="{loc:Translate ChooseFolder}" Click="OnAddFolderClicked" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Filliste (ListView) når elementer er lagt til -->
                <ui:Card Grid.Row="1" 
                         Padding="4" 
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                    <ListView ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              GridViewColumnHeader.Click="OnColumnHeaderClick">

                        <!-- Moderne markering for valgt rad med god kontrast -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="42" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    CornerRadius="4"
                                                    Margin="2,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#264CC2FF" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#804CC2FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <!-- Filnavn & Miniatyrbilde med rotasjonsvisning -->
                                <GridViewColumn Header="{loc:Translate Col_FileName}" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                                <Grid Width="34" Height="34" Margin="0,0,8,0">
                                                    <ui:SymbolIcon x:Name="FallbackIcon" Symbol="Image32" Foreground="#4CC2FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border x:Name="ThumbBorder" CornerRadius="4" ClipToBounds="True" Visibility="Collapsed" Background="#11FFFFFF">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                                            <Image.LayoutTransform>
                                                                <RotateTransform Angle="{Binding TotalRotation}" />
                                                            </Image.LayoutTransform>
                                                        </Image>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding FileName}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                    <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ThumbBorder" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Oppløsning -->
                                <GridViewColumn Header="{loc:Translate Col_Dimensions}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Dimensions}" 
                                                       VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Størrelse -->
                                <GridViewColumn Header="{loc:Translate Col_Size}" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedSize}" 
                                                       VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Status: Høy kontrast merker med lokalisert tekst -->
                                <GridViewColumn Header="{loc:Translate Col_Status}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                        <Style.Triggers>
                                                             <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Venter}">
                                                                <Setter Property="Background" Value="#25888888" />
                                                                <Setter Property="TextBlock.Foreground" Value="#E0E0E0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Behandler}">
                                                                <Setter Property="Background" Value="#334CC2FF" />
                                                                <Setter Property="TextBlock.Foreground" Value="#4CC2FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Fullført}">
                                                                <Setter Property="Background" Value="#3354D281" />
                                                                <Setter Property="TextBlock.Foreground" Value="#54D281" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConversionStatus.Feilet}">
                                                                <Setter Property="Background" Value="#33FF6B6B" />
                                                                <Setter Property="TextBlock.Foreground" Value="#FF6B6B" />
                                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Mappe -->
                                <GridViewColumn Header="{loc:Translate Col_Folder}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Directory}" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ui:Card>

                <!-- Bunnlinje: Status og Fremgang -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusSummary}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressText}" 
                                   HorizontalAlignment="Right" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Value="{Binding ProgressValue}"
                                 Maximum="100"
                                 Height="8"
                                 BorderThickness="0" />
                </Grid>
            </Grid>

            <!-- HØYRE: Innstillinger og Konverteringsknapp -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Kort: Konverteringsmodus -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_ModeTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Mode_Individual}"
                                         IsChecked="{Binding IsIndividualMode, Mode=TwoWay}"
                                         Margin="0,0,0,6" />
                            <RadioButton Content="{loc:Translate Mode_Merged}"
                                         IsChecked="{Binding IsMergedMode, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <!-- Filnavn for samlet PDF -->
                            <StackPanel Margin="24,6,0,0" 
                                        Visibility="{Binding IsMergedMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate MergedFileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MergedFileName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Kvalitet & Komprimering -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Quality}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Quality_Lossless}"
                                         IsChecked="{Binding IsLosslessQuality, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Quality_LosslessDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Quality_Compressed}"
                                         IsChecked="{Binding IsCompressedQuality, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Quality_CompressedDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <!-- Slider for komprimeringsgrad -->
                            <StackPanel Margin="24,0,0,4" Visibility="{Binding IsCompressedQuality, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding JpegQuality, StringFormat='{}{0}%'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                    <TextBlock Text="{loc:Translate CompressionLevel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="50" Maximum="95" Value="{Binding JpegQuality, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Sideoppsett & Marger -->
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_PageSetup}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Size_Original}"
                                         IsChecked="{Binding IsOriginalSize, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Size_OriginalDesc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Size_A4}"
                                         IsChecked="{Binding IsA4Size, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Translate Size_A4Desc}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="24,0,0,8"
                                       TextWrapping="Wrap" />

                            <RadioButton Content="{loc:Translate Size_Letter}"
                                         IsChecked="{Binding IsLetterSize, Mode=TwoWay}"
                                         Margin="0,0,0,4" />

                            <!-- Sidemarger (kun tilgjengelig for A4 og Letter) -->
                            <StackPanel Margin="24,6,0,0" Visibility="{Binding HasMarginsConfigurable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate Section_Margins}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                <RadioButton Content="{loc:Translate Margin_None}"
                                             IsChecked="{Binding IsMarginNone, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                                <RadioButton Content="{loc:Translate Margin_Compact}"
                                             IsChecked="{Binding IsMarginCompact, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                                <RadioButton Content="{loc:Translate Margin_Normal}"
                                             IsChecked="{Binding IsMarginNormal, Mode=TwoWay}"
                                             Margin="0,0,0,4" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Utdatamappe -->
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_OutputFolder}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Translate Output_Source}"
                                         IsChecked="{Binding UseSourceFolder, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <RadioButton Content="{loc:Translate Output_Custom}"
                                         IsChecked="{Binding UseCustomOutputFolder, Mode=TwoWay}"
                                         Margin="0,0,0,6" />

                            <DockPanel Margin="0,4,0,10"
                                       Visibility="{Binding UseCustomOutputFolder, Converter={StaticResource BoolToVis}}">
                                <ui:Button DockPanel.Dock="Right" Content="{loc:Translate Browse}" Click="OnBrowseFolderClicked" Margin="6,0,0,0" />
                                <TextBox Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <CheckBox Content="{loc:Translate OpenWhenDone}"
                                      IsChecked="{Binding OpenFolderWhenDone, Mode=TwoWay}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Kort: Sikkerhet & Passordbeskyttelse -->
                    <ui:Card Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Card_Security}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <CheckBox Content="{loc:Translate Security_Enable}"
                                      IsChecked="{Binding EnablePasswordProtection, Mode=TwoWay}"
                                      Margin="0,0,0,6" />

                            <StackPanel Margin="24,2,0,0"
                                        Visibility="{Binding EnablePasswordProtection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Translate Security_PasswordLabel}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="12" 
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{loc:Translate Security_Desc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Hovedknapp / Konverter -->
                    <Grid>
                        <!-- Start-knapp -->
                        <ui:Button Content="{loc:Translate StartConversion}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon PlayCircle24}"
                                   Height="48"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding StartConversionCommand}"
                                   IsEnabled="{Binding CanConvert}"
                                   Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Avbryt-knapp (vises kun under kjøring) -->
                        <ui:Button Content="{loc:Translate CancelConversion}"
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon DismissCircle24}"
                                   Height="48"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding CancelConversionCommand}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
